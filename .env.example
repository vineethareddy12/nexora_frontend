# ==============================================================================
# Nexora Frontend Environment Configuration Template
# Copy this file to .env in your client directory.
# NEVER commit .env to source control!
# ==============================================================================

# Backend API Base URL
# - In local development: leave blank to leverage Vite's proxy (http://localhost:4000)
# - In production / custom deployment: set to your backend API domain (e.g. https://api.nexoratech.com)
VITE_API_BASE_URL=

